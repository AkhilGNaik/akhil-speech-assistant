<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SpeechAssistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Splash Screen theme. -->
    <style name="Theme.SpeechAssistant.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Caregiver/Admin Premium Dark Accessibility Dashboard Theme -->
    <style name="Theme.CaregiverDashboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/caregiver_accent</item>
        <item name="colorPrimaryVariant">#1E293B</item>
        <item name="colorOnPrimary">#0F172A</item>
        <item name="colorSecondary">@color/caregiver_accent</item>
        <item name="colorSecondaryVariant">#312E81</item>
        <item name="colorOnSecondary">#0F172A</item>
        <item name="android:statusBarColor">#1E293B</item>
        <item name="android:windowBackground">@color/caregiver_bg</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
