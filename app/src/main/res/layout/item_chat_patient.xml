<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutPatientItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar Section -->
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatarCard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/caregiver_accent_dark"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="P"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Dot overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/indicatorCard"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignBottom="@id/avatarCard"
            android:layout_alignEnd="@id/avatarCard"
            app:cardCornerRadius="6dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/caregiver_text_secondary"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/caregiver_surface" />
    </RelativeLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textColor="@color/caregiver_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtUserType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Deaf User"
            android:textColor="@color/caregiver_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtLastMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="No messages yet."
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Right Side Metrics (Time & Badge) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/txtLastMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/caregiver_text_muted"
            android:textSize="10sp" />

        <!-- Unread Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUnreadBadge"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/caregiver_success"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtUnreadCount"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
