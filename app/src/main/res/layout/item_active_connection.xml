<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/caregiver_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/caregiver_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtConnectedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected User"
            android:textColor="@color/caregiver_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtConnectedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="@color/caregiver_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txtConnectedEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@example.com"
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/txtConnectedRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Role: Deaf User"
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Disconnect Caregiver"
            android:textColor="@color/caregiver_danger"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/caregiver_danger"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
