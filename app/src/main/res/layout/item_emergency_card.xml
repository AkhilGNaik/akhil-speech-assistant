<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEmergencyRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/caregiver_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/caregiver_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title / Header -->
        <TextView
            android:id="@+id/txtEmergencyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 EMERGENCY"
            android:textColor="@color/caregiver_danger"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Patient Name -->
        <TextView
            android:id="@+id/txtPatientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient: Akhil"
            android:textColor="@color/caregiver_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- User ID -->
        <TextView
            android:id="@+id/txtPatientId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User ID: USR001"
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <!-- Message -->
        <TextView
            android:id="@+id/txtEmergencyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message: I need immediate help."
            android:textColor="@color/caregiver_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Date -->
        <TextView
            android:id="@+id/txtEmergencyDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 16 July 2026"
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <!-- Time -->
        <TextView
            android:id="@+id/txtEmergencyTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: 10:42 AM"
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/txtEmergencyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_caregiver_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Status: NEW"
            android:textColor="@color/caregiver_danger"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/caregiver_border"
            android:layout_marginBottom="12dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAlert"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="View"
                android:textColor="@color/caregiver_text_primary"
                android:textSize="11sp"
                app:backgroundTint="#334155"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcknowledgeAlert"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Acknowledge"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="11sp"
                app:backgroundTint="@color/caregiver_warning"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResolveAlert"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Resolve"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="11sp"
                app:backgroundTint="@color/caregiver_success"
                app:cornerRadius="8dp"
                android:paddingHorizontal="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
