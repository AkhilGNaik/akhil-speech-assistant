<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutKannadaKeyboard"
        android:fillViewport="true">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Voice Assistant Section Header & Control -->
        <RelativeLayout
            android:id="@+id/layoutVoiceAssistantRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <!-- Voice Assistant Accessible Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceAssistant"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minHeight="42dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="🎤 Voice Assistant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="21dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="Voice Assistant" />

            <!-- Active Toggle Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVoiceAssistant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                android:text="Active"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </RelativeLayout>

        <!-- 1. Text-to-Speech Quick Card with Dual Keyboard Support -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_talk_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Keyboard Selector Toggle -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleKeyboardGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    app:singleSelection="true"
                    app:checkedButton="@+id/btnToggleEnglish">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleEnglish"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/english_translit"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleKannada"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kannada_keyboard"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Input Text Box -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/editHomeQuickText"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:hint="@string/quick_text_hint"
                        android:backgroundTint="#F1F5F9"
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:paddingEnd="48dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:inputType="textMultiLine"
                        android:importantForAutofill="no"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/btnMicInput"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_mic"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/text_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Voice Input"/>
                </RelativeLayout>

                <!-- Translit status indicator -->
                <LinearLayout
                    android:id="@+id/layoutHomeTranslitStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="visible">

                    <ProgressBar
                        android:id="@+id/progressHomeTranslit"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/primary" />

                    <TextView
                        android:id="@+id/txtHomeTranslitStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English Translit active. (Auto-converting)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>



                <!-- Control Buttons Row: Convert, Clear, Copy, Speak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">

                    <!-- Clear -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeClear"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/clear"
                        android:textSize="11sp"
                        app:strokeColor="#CBD5E1"
                        android:textColor="@color/text_secondary" />

                    <!-- Send -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeSend"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/send"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Recently Used Phrases Container -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recently_used"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutHomeRecentPhrases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp" />
                </HorizontalScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Conversation with Caregiver -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_caregiver"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCaregiverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCaregiverChatContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutCaregiverChatEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_caregiver"
                        app:tint="#94A3B8"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="No messages icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_messages_yet"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">



                    <!-- Messages List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCaregiverChatMessages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:padding="12dp"
                        android:scrollbars="vertical"
                        android:visibility="gone" />
                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>
</ScrollView>

    <!-- Custom On-Screen Keyboard Container (Visible only when Kannada Keyboard is selected) -->
    <LinearLayout
        android:id="@+id/layoutKannadaKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F1F5F9"
        android:padding="6dp"
        android:layout_alignParentBottom="true"
        android:visibility="gone">

        <!-- Row 1: 10 Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key1" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key2" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key3" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key4" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key5" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key6" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key7" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key8" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key9" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow1Key10" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
        </LinearLayout>

        <!-- Row 2: 10 Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key1" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key2" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key3" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key4" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key5" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key6" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key7" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key8" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key9" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow2Key10" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
        </LinearLayout>

        <!-- Row 3: 9 Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key1" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key2" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key3" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key4" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key5" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key6" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key7" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key8" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRow3Key9" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="14sp" app:backgroundTint="#FFFFFF" app:cornerRadius="4dp" android:padding="0dp" android:insetBottom="0dp" android:insetTop="0dp"/>
        </LinearLayout>

        <!-- Row 4: Shift, 7 Keys, Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">
            <!-- Shift Button -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnKeyboardShift" style="@style/Widget.MaterialComponents.Button.Icon" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.2" android:layout_margin="1dp" android:textColor="#0F172A" android:textSize="18sp" app:backgroundTint="#CBD5E1" app:strokeWidth="1dp" app:strokeColor="#94A3B8" app:cornerRadius="4dp" android:padding="0dp" android:text="⇧" android:insetBottom="0dp" android:insetTop="0dp"/>
            
