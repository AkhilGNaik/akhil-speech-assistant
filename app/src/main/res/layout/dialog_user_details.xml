<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/caregiver_card">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Profile Details"
        android:textColor="@color/caregiver_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Name & Role -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/dialogName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="John Doe"
            android:textColor="@color/caregiver_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_caregiver_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Patient"
            android:textColor="@color/caregiver_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Email -->
    <TextView
        android:id="@+id/dialogEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="johndoe@example.com"
        android:textColor="@color/caregiver_text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- Registration Date -->
    <TextView
        android:id="@+id/dialogRegDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registered: June 18, 2026"
        android:textColor="@color/caregiver_text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <!-- Language Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Language: "
            android:textColor="@color/caregiver_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kannada"
            android:textColor="@color/caregiver_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/caregiver_border"
        android:layout_marginBottom="16dp" />

    <!-- Caregiver Connections Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caregiver Connections"
        android:textColor="@color/caregiver_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/dialogConnections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading connections..."
        android:textColor="@color/caregiver_text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Emergency Alerts Count Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency History"
        android:textColor="@color/caregiver_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/dialogAlertCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading alert history..."
        android:textColor="@color/caregiver_text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnCall"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="📞 Call"
            android:textColor="@color/caregiver_accent"
            app:strokeColor="@color/caregiver_accent"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="💬 Chat"
            android:textColor="#0F172A"
            android:textStyle="bold"
            app:backgroundTint="@color/caregiver_accent"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/caregiver_text_secondary" />
    </LinearLayout>
</LinearLayout>
